# Glitch Grow — Custom-distribution agency Shopify app
# Copy to .env and fill real values. NEVER commit .env.

SHOPIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_APP_URL=https://shopify.glitchexecutor.com
SCOPES=write_products,write_content,write_files,write_themes,write_translations,write_inventory,read_locales,read_product_listings,write_online_store_navigation
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/shopify_app?schema=public
NODE_ENV=production
PORT=3101

# Secondary OAuth apps — one env var group per client org.
# Each client = one Dev Dashboard OAuth app in their own org.
# Route lives at app/routes/auth.<slug>.$.jsx and reads <SLUG>_CLIENT_ID/_CLIENT_SECRET/_SCOPES.
CLASSICOO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLASSICOO_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLASSICOO_SCOPES=write_products,write_content,write_files,write_themes,write_translations,write_inventory,read_locales,read_product_listings,write_online_store_navigation
